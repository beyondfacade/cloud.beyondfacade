# cp terraform.tfvars.example terraform.tfvars 후 채운다 (terraform.tfvars는 gitignore)
admin_cidrs = ["203.0.113.10/32"] # curl -s https://checkip.amazonaws.com 결과 + /32
alert_email = "you@example.com"

# 부하 테스트 50%·100% 단계에서만 올렸다가 되돌린다 (serverplan §20-4)
# node_max_size     = 8
# db_instance_class = "db.m7g.xlarge"
# loadtest_runner        = true          # k6용 EC2 (loadtest.tf) — 테스트 기간에만
# loadtest_instance_type = "c7g.2xlarge" # 11-3(VU 3,000명)
# db_multi_az            = true          # 부하 테스트·장애 조치 리허설 기간에만 (§21-8)
